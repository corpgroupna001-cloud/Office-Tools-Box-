{
  "cleanUrls": true,
  "trailingSlash": false,
  "crons": [
    {
      "path": "/api/wfh-remind",
      "schedule": "30 3 * * *"
    },
    {
      "path": "/api/wfh-remind",
      "schedule": "30 13 * * *"
    }
  ],
  "rewrites": [
    {
      "source": "/api/send-verify",
      "destination": "/api/verify?fn=send"
    },
    {
      "source": "/api/verify-code",
      "destination": "/api/verify?fn=check"
    },
    {
      "source": "/messenger",
      "destination": "/chat/index.html"
    },
    {
      "source": "/messenger/",
      "destination": "/chat/index.html"
    }
  ],
  "redirects": [
    {
      "source": "/admin",
      "destination": "/wsm-admin",
      "permanent": false
    },
    {
      "source": "/admin/",
      "destination": "/wsm-admin",
      "permanent": false
    },
    {
      "source": "/admin/index",
      "destination": "/wsm-admin",
      "permanent": false
    },
    {
      "source": "/admin/index.html",
      "destination": "/wsm-admin",
      "permanent": false
    },
    {
      "source": "/Network.ADMIN",
      "destination": "/wsm-admin",
      "permanent": false
    },
    {
      "source": "/Network.ADMIN/",
      "destination": "/wsm-admin",
      "permanent": false
    },
    {
      "source": "/macshortcuts",
      "destination": "/mcqquiz",
      "permanent": false
    },
    {
      "source": "/macshortcuts/",
      "destination": "/mcqquiz",
      "permanent": false
    },
    {
      "source": "/keyboardninja",
      "destination": "/mcqquiz",
      "permanent": false
    },
    {
      "source": "/keyboardninja/",
      "destination": "/mcqquiz",
      "permanent": false
    }
  ]
}
