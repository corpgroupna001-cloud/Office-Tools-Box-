      "destination": "/mcqquiz",
      "permanent": false
    },
    {
      "source": "/macshortcuts/",
      "destination": "/mcqquiz",
      "permanent": false
    },
    {
      "source": "/keyboardninja",
      "destination": "/mcqquiz",
      "permanent": false
    },
    {
      "source": "/keyboardninja/",
      "destination": "/mcqquiz",
      "permanent": false
    }
  ]
