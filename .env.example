# ============================================================================
# WorkSuite environment variables — PLACEHOLDERS ONLY. Never commit real values.
#
# Production: Vercel → Project → Settings → Environment Variables.
# Local development: copy this file to .env.local (git-ignored) and fill it in,
# then `npm run dev`. See SETUP.md for where each value comes from.
# ============================================================================

# ---- Required ---------------------------------------------------------------
# Supabase → Project Settings → API.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=replace-with-the-anon-public-key
# Full database access, server-only. Never put it in a page or a commit.
SUPABASE_SERVICE_ROLE_KEY=replace-with-the-service-role-key
# Shared admin console password (fallback; administrators can also sign in with their account).
ADMIN_PASSWORD=replace-with-a-long-random-password

# ---- Email (sign-up codes, invitations, invoices, attendance) ----------------
# Internal key /api/signup-start and /api/verify use to call /api/mail.
MAIL_API_KEY=replace-with-a-long-random-key
SMTP_HOST=mail.example.com
SMTP_PASS=replace-with-the-mailbox-password
# One sender mailbox per company (lib/mailer.js COMPANY_TO_USER).
SMTP_USER_1=hr@nova.example.com
SMTP_USER_2=hr@jobways.example.com
SMTP_USER_3=hr@genielamp.example.com
SMTP_FROM_NAME=WorkSuite
# The certificate is always verified. If the host presents a certificate for
# another name (common on cPanel), set that name here; a private CA goes in
# SMTP_TLS_CA (PEM text, or base64 of it).
SMTP_TLS_SERVERNAME=
SMTP_TLS_CA=
# Public address of the site, used in invitation links (defaults to the request host).
APP_URL=https://work-suite.example.com

# ---- Biometric attendance (api/attendance-webhook) ---------------------------
BIOMETRIC_API_KEY=replace-with-the-device-cloud-key
ATTENDANCE_EMAIL_MAX_AGE_HOURS=12
# Optional company-wide Bitrix24 webhook; per-person hooks are BITRIX_HOOK_<enroll number>.
BITRIX_WEBHOOK_URL=
# BITRIX_HOOK_101=https://example.bitrix24.com/rest/1/xxxxxxxx/

# ---- Scheduled jobs ------------------------------------------------------------
# Vercel sends it to the cron endpoints; the attendance scheduler uses its own database secret.
CRON_SECRET=replace-with-a-long-random-secret
SELFIE_RETENTION_DAYS=90

# ---- Web push (api/push) ------------------------------------------------------
# npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com

# ---- AI (typing passages, quizzes) --------------------------------------------
GROQ_API_KEY=
GROQ_MODEL=

# ---- Calls behind strict firewalls: a TURN relay (optional; pick one) --------
CLOUDFLARE_TURN_KEY_ID=
CLOUDFLARE_TURN_API_TOKEN=
METERED_TURN_DOMAIN=
METERED_TURN_API_KEY=
TURN_URLS=
TURN_SECRET=
TURN_USERNAME=
TURN_CREDENTIAL=
TURN_TTL_SECONDS=

# ---- Desktop app build (desktop/) --------------------------------------------
WORKSUITE_URL=https://work-suite.example.com
