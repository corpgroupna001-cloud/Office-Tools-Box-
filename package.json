{
  "name": "worksuite",
  "version": "1.0.0",
  "private": true,
  "description": "WorkSuite — internal productivity tools (Vercel + Supabase).",
  "scripts": {
    "test": "node --test tests/*.test.js",
    "smoke:ui": "node tests/ui-smoke/smoke.js",
    "test:calls": "node tests/ui-smoke/calls-webrtc.js",
    "check": "node scripts/check-static.js",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.browser.json",
    "verify": "npm run check && npm run lint && npm run typecheck && npm test"
  },
  "dependencies": {
    "nodemailer": "^10.0.13",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.19.0",
    "eslint": "^10.11.0",
    "globals": "^17.13.0",
    "puppeteer-core": "^25.10.0",
    "typescript": "^7.0.2"
  }
}
